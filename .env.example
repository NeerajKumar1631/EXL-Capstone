# Copy to .env and fill in. .env is git-ignored.

# Event Registry / newsapi.ai key — register at https://eventregistry.org (free tier).
# (This project does NOT use newsapi.org.)
NEWS_API_KEY=your_event_registry_key_here

# Gemini — free key at https://aistudio.google.com/apikey (format usually starts with AIza...).
# Use a current model; gemini-flash-latest auto-tracks the newest flash model.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Optional — HuggingFace token for faster/authenticated model downloads.
HF_TOKEN=
